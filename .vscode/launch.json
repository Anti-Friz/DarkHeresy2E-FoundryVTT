{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "npm: build",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["build"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: build:css",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["build:css"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: build:watch",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["run", "build:watch"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: lint",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["run", "lint"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: lint:fix",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["run", "lint:fix"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: test",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["run", "test"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "npm: release",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/npm",
            "args": ["release"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
